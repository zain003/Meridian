# ==============================================
# Meridian Environment Configuration
# ==============================================

# ----------------------------------------------
# 1. Database (PostgreSQL / Prisma) - REQUIRED
# ----------------------------------------------
# Provide your PostgreSQL connection string (Supabase, Neon, Prisma Data Proxy, or local PostgreSQL).
# Example: postgresql://postgres:password@localhost:5432/meridian?schema=public
DATABASE_URL="postgresql://user:password@localhost:5432/meridian?schema=public"

# ----------------------------------------------
# 2. Authentication (Auth.js v5) - REQUIRED
# ----------------------------------------------
# Generate a secret by running: npx auth secret (or 32-character random string)
AUTH_SECRET="replace-with-a-secure-random-secret-key"
AUTH_URL="http://localhost:3000"

# ----------------------------------------------
# 3. OAuth Providers - OPTIONAL
# ----------------------------------------------
# Google OAuth: https://console.cloud.google.com/apis/credentials
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# GitHub OAuth: https://github.com/settings/developers
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# ----------------------------------------------
# 4. Real-Time Sync & Live Presence (Pusher) - REQUIRED FOR REALTIME
# ----------------------------------------------
# Get your free Pusher Channels keys at: https://dashboard.pusher.com/
PUSHER_APP_ID="your_pusher_app_id"
PUSHER_KEY="your_pusher_key"
NEXT_PUBLIC_PUSHER_KEY="your_pusher_key"
PUSHER_SECRET="your_pusher_secret"
PUSHER_CLUSTER="mt1"
NEXT_PUBLIC_PUSHER_CLUSTER="mt1"

# ----------------------------------------------
# 5. Automation Background Worker (Upstash Redis) - OPTIONAL
# ----------------------------------------------
# Get free Upstash Redis REST credentials at: https://console.upstash.com/
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Secret to secure automated cron execution endpoint at /api/cron/automations
CRON_SECRET="your_secure_cron_secret"

# ----------------------------------------------
# 6. Transactional Email (Resend) - OPTIONAL (Fallback simulated if empty)
# ----------------------------------------------
# Get your free Resend API key at: https://resend.com/api-keys
RESEND_API_KEY=""
EMAIL_FROM="Meridian <onboarding@resend.dev>"

# ----------------------------------------------
# 7. Subscription Billing (Stripe) - OPTIONAL (For Pro Upgrades & Portals)
# ----------------------------------------------
# Get Stripe Test Mode keys at: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# For local webhook forwarding with Stripe CLI:
# stripe listen --forward-to localhost:3000/api/webhooks/stripe
STRIPE_WEBHOOK_SECRET="whsec_..."
